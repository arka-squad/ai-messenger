# Copie ce fichier en .env.local (non versionné) et renseigne-le.
# Sans lui, `npm run dev` utilise la boîte mémorisée par `python3 messenger.py setup`.

# La boîte : un fichier .json (ou une ancienne boîte .md, ouverte en lecture seule).
MESSENGER_BOX=/chemin/vers/le/dossier/partagé/boite.json

# Le compte au nom duquel l'interface fait avancer les statuts (défaut : owner).
MESSENGER_AGENT=owner

# L'interpréteur Python, si ni python3 ni python ne conviennent.
# MESSENGER_PYTHON=python3
